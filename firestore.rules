rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    // Manager: reads everything, writes nothing. Use isStaff() in READ
    // positions only — never in write positions.
    function isStaff() {
      return isSignedIn() && (userRole() == 'admin' || userRole() == 'manager');
    }

    function isProjectMember(pid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid));
    }

    function memberPermissions(pid) {
      return get(/databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid)).data.permissions;
    }

    function hasProjectPerm(pid, perm) {
      return isAdmin() || (isProjectMember(pid) && perm in memberPermissions(pid));
    }

    // ─────────────────────────────────────────────────────
    // Users — admins manage; workers read their own doc.
    // ─────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isMe(uid) || isStaff();
      allow create, delete: if isAdmin();
      // Workers may edit their own profile details but can never touch
      // role, active status, or project assignments.
      allow update: if isAdmin() ||
        (isMe(uid) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.active == resource.data.active &&
         request.resource.data.projectIds == resource.data.projectIds);
    }

    // ─────────────────────────────────────────────────────
    // Projects
    // ─────────────────────────────────────────────────────

    match /projects/{pid} {
      allow read: if isStaff() || isProjectMember(pid);
      allow create, update, delete: if isAdmin();

      // Members — admins manage
      match /members/{uid} {
        allow read: if isMe(uid) || isStaff() || isProjectMember(pid);
        allow write: if isAdmin();
      }

      // Build phases (lifecycle) — crew sees them; foremen advance/complete;
      // admin manages.
      match /phases/{phaseId} {
        allow read: if isStaff() || isProjectMember(pid);
        // Phases carry invoice fields — deleting an invoiced phase would
        // erase the billing record.
        allow create: if isAdmin();
        allow delete: if isAdmin() && !('invoicedAt' in resource.data);
        // Foremen advance/complete phases only. invoiceMilestone /
        // invoicedAt / invoicedBy are money — admin-only.
        allow update: if isAdmin() ||
                         (hasProjectPerm(pid, 'supervisor.forms.approve') &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'completedAt', 'completedBy']));
      }

      // Plans — view requires project access; foremen and admin upload.
      match /plans/{planId} {
        allow read: if isProjectMember(pid) || isStaff();
        allow create, update: if isAdmin() ||
                                 hasProjectPerm(pid, 'supervisor.forms.approve');
        allow delete: if isAdmin();

        // Pin-tasks on the drawing: foremen create/assign; the assigned
        // worker can mark their own pin done; foremen/admin accept.
        match /pins/{pinId} {
          allow read: if isProjectMember(pid) || isStaff();
          allow create: if isAdmin() ||
                           hasProjectPerm(pid, 'supervisor.forms.approve');
          allow update: if isAdmin() ||
                           hasProjectPerm(pid, 'supervisor.forms.approve') ||
                           (resource.data.assigneeUid == request.auth.uid &&
                            request.resource.data.status != 'accepted');
          allow delete: if isAdmin();
        }
      }

      // Media — workers w/ upload perm can create; only the uploader or admin can delete
      match /media/{mediaId} {
        allow read: if isProjectMember(pid) || isStaff();
        allow create: if hasProjectPerm(pid, 'worker.media.upload') &&
                         request.resource.data.uploadedBy == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin() ||
                         (resource.data.uploadedBy == request.auth.uid);
      }

      // Submissions — workers with submit perm can create their own;
      // only admins and supervisors with approve perm can read others'.
      match /submissions/{subId} {
        allow read: if isStaff() ||
                       (isProjectMember(pid) && (
                         resource.data.submittedBy == request.auth.uid ||
                         hasProjectPerm(pid, 'supervisor.forms.approve')
                       ));
        // submittedAt is pinned to a bounded window (36h back covers the
        // offline queue) so the 24h edit window below can't be gamed with
        // a future-dated submission. No approval/PDF fields on create.
        allow create: if hasProjectPerm(pid, 'worker.forms.submit') &&
                         request.resource.data.submittedBy == request.auth.uid &&
                         request.resource.data.submittedAt is timestamp &&
                         request.resource.data.submittedAt.toMillis() <= request.time.toMillis() + 5 * 60 * 1000 &&
                         request.resource.data.submittedAt.toMillis() >= request.time.toMillis() - 36 * 60 * 60 * 1000 &&
                         !('approvedBy' in request.resource.data) &&
                         (!('pdfPath' in request.resource.data) || request.resource.data.pdfPath == null);
        // PDF path is appended server-side by Cloud Function (Admin SDK
        // bypasses rules). Owner may update their own submission same-day
        // only (End of Day answers at clock-out) — and only the answer
        // fields: identity, schema, PDF and approval fields are immutable.
        allow update: if isAdmin() ||
                         (resource.data.submittedBy == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['values', 'endOfDayAt', 'pendingSync', 'updatedAt']) &&
                          request.time.toMillis() - resource.data.submittedAt.toMillis() < 24 * 60 * 60 * 1000);
        allow delete: if isAdmin();
      }

      // Attendance — workers see their own; supervisors see project-wide
      match /attendance/{attId} {
        allow read: if isStaff() ||
                       resource.data.uid == request.auth.uid ||
                       hasProjectPerm(pid, 'supervisor.attendance.clockout-others');

        // Create — two paths, both field-validated (hours are payroll):
        //  1. Self clock-in: open shift only, no status/approval fields,
        //     clockInAt within a bounded window (36h back for offline
        //     queue sync, 5min forward for clock skew). No backdated,
        //     pre-closed, or pre-approved shifts.
        //  2. Foreman manual entry: flagged, attributed, NOT for yourself,
        //     backdatable max 14 days, lands 'pending'.
        allow create: if (isProjectMember(pid) &&
                          request.resource.data.uid == request.auth.uid &&
                          (!('manualEntry' in request.resource.data) || request.resource.data.manualEntry == false) &&
                          request.resource.data.clockOutAt == null &&
                          !('status' in request.resource.data) &&
                          !('approvedBy' in request.resource.data) &&
                          !('breakMinutes' in request.resource.data) &&
                          request.resource.data.clockInAt is timestamp &&
                          request.resource.data.clockInAt.toMillis() <= request.time.toMillis() + 5 * 60 * 1000 &&
                          request.resource.data.clockInAt.toMillis() >= request.time.toMillis() - 36 * 60 * 60 * 1000) ||
                         (hasProjectPerm(pid, 'supervisor.attendance.clockout-others') &&
                          request.resource.data.manualEntry == true &&
                          request.resource.data.enteredBy == request.auth.uid &&
                          request.resource.data.uid != request.auth.uid &&
                          request.resource.data.status == 'pending' &&
                          !('approvedBy' in request.resource.data) &&
                          request.resource.data.clockInAt is timestamp &&
                          request.resource.data.clockOutAt is timestamp &&
                          request.resource.data.clockInAt.toMillis() >= request.time.toMillis() - 14 * 24 * 60 * 60 * 1000 &&
                          request.resource.data.clockInAt.toMillis() <= request.time.toMillis() + 24 * 60 * 60 * 1000);

        // Update — every branch is scoped to exactly the fields it needs.
        // Times can never be rewritten after the fact except by admin.
        //  · worker: close their OWN OPEN shift, nothing else
        //  · clockout-others: close someone's open shift
        //  · approve: status flip only — never your own shift, never a
        //    shift you manually entered (separation of duties), never
        //    re-writing an already-approved record
        allow update: if isAdmin() ||
                         (resource.data.uid == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['clockOutAt', 'clockOutBy', 'status', 'offlineQueued']) &&
                          (!('status' in resource.data) || resource.data.status != 'approved') &&
                          request.resource.data.status == 'pending' &&
                          resource.data.clockOutAt == null &&
                          request.resource.data.clockOutAt is timestamp &&
                          request.resource.data.clockOutAt.toMillis() <= request.time.toMillis() + 5 * 60 * 1000 &&
                          request.resource.data.clockOutAt.toMillis() >= request.time.toMillis() - 36 * 60 * 60 * 1000) ||
                         (hasProjectPerm(pid, 'supervisor.attendance.clockout-others') &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['clockOutAt', 'clockOutBy', 'status']) &&
                          resource.data.clockOutAt == null &&
                          request.resource.data.status == 'pending' &&
                          request.resource.data.clockOutBy == request.auth.uid) ||
                         (hasProjectPerm(pid, 'supervisor.attendance.approve') &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'approvedBy', 'approvedAt', 'needsReview']) &&
                          request.resource.data.status == 'approved' &&
                          request.resource.data.approvedBy == request.auth.uid &&
                          resource.data.uid != request.auth.uid &&
                          (!('enteredBy' in resource.data) || resource.data.enteredBy != request.auth.uid) &&
                          (!('status' in resource.data) || resource.data.status != 'approved'));

        allow delete: if isAdmin();
      }

      // Material counts (AI Camera) — members record; office reads.
      match /materialCounts/{countId} {
        allow read: if isStaff() || isProjectMember(pid);
        allow create: if isProjectMember(pid) &&
                         request.resource.data.countedBy == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // Work log — members post their own entries; foremen/admin can amend.
      match /workLog/{entryId} {
        allow read: if isStaff() || isProjectMember(pid);
        allow create: if isProjectMember(pid) &&
                         request.resource.data.uid == request.auth.uid;
        allow update: if isAdmin() ||
                         hasProjectPerm(pid, 'supervisor.forms.approve') ||
                         resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Deficiencies (punch list) — any project member can report; admins
      // and supervisors can update status/resolve.
      match /deficiencies/{defId} {
        allow read: if isStaff() || isProjectMember(pid);
        allow create: if isProjectMember(pid) &&
                         request.resource.data.reportedBy == request.auth.uid;
        allow update: if isAdmin() ||
                         hasProjectPerm(pid, 'supervisor.forms.approve') ||
                         resource.data.reportedBy == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Expenses (job costing from receipts) — project members can record;
      // admins manage. Supervisor can approve in v0.3.
      match /expenses/{expId} {
        allow read: if isStaff() || isProjectMember(pid);
        allow create: if isProjectMember(pid) &&
                         request.resource.data.recordedBy == request.auth.uid;
        allow update: if isAdmin() ||
                         resource.data.recordedBy == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Daily logs — one per date. Supervisors and admins write; project
      // members can read.
      match /dailyLogs/{date} {
        allow read: if isStaff() || isProjectMember(pid);
        allow create, update: if isAdmin() ||
                                  hasProjectPerm(pid, 'supervisor.forms.approve') ||
                                  isProjectMember(pid); // any member for v0.2; v0.3 restricts
        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────
    // User certifications — workers manage their own; admins read all.
    // ─────────────────────────────────────────────────────

    match /users/{uid}/certifications/{certId} {
      allow read: if isMe(uid) || isStaff();
      // Workers attach evidence; ADMINS confer validity. A self-added cert
      // is always verified:false until the office checks the ticket —
      // otherwise a fake 'First Aid' entry flips the WorkSafeBC crew
      // check green. Legacy certs (no verified field) grandfathered in
      // the checks; new ones need office sign-off.
      allow create: if isAdmin() ||
                       (isMe(uid) && request.resource.data.verified == false);
      allow update: if isAdmin() ||
                       (isMe(uid) &&
                        request.resource.data.verified == false &&
                        (!('verified' in resource.data) || resource.data.verified == false));
      allow delete: if isAdmin() ||
                       (isMe(uid) &&
                        (!('verified' in resource.data) || resource.data.verified == false));
    }

    // Worker notifications — written by Cloud Functions; worker reads own,
    // marks own as read.
    match /users/{uid}/notifications/{nid} {
      allow read: if isMe(uid) || isStaff();
      // Mark-read only — the notification BODY is a record; letting the
      // recipient (or a view-only manager) rewrite "your ticket expires"
      // into "cert verified" would defeat the point.
      allow update: if (isMe(uid) || isStaff()) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read', 'readAt']);
      allow create, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // Form schemas — read by anyone signed in, write by admin.
    // ─────────────────────────────────────────────────────

    match /forms/{formId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // Templates — read by anyone signed in, write by admin.
    // ─────────────────────────────────────────────────────

    match /templates/{tid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // Dashboard config — read by signed-in, write by admin.
    // ─────────────────────────────────────────────────────

    match /dashboards/{role}/modules/{mid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // Notifications — office inbox. Written by Cloud Functions
    // (Admin SDK bypasses rules); admins read + mark read.
    // ─────────────────────────────────────────────────────

    match /notifications/{nid} {
      allow read: if isStaff();
      // Manager may mark read — and only that; the alert text itself is
      // the office record.
      allow update: if isStaff() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read', 'readAt']);
      allow create, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────
    // CRM — clients and their communication log. The legal record of
    // who said what, when. Office only.
    // ─────────────────────────────────────────────────────

    match /clients/{clientId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Comm log entries are append-only: no edits, no deletes — that's
      // what makes it a record.
      match /comms/{commId} {
        allow read: if isStaff();
        allow create: if isAdmin() &&
                         request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
